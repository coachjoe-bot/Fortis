<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<!-- Deep link target for the lock-screen session card: tapping the Live
	     Activity opens wilco://quicklog, which src/App.jsx routes into the Quick
	     Log sheet with today's draft loaded. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.trainwilco.wilco</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wilco</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>WILCO</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- arm64, not the Capacitor template's legacy armv7. The deployment target is
	     iOS 15.0, which is arm64-only, so armv7 was declaring a 32-bit capability
	     no supported device has. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>NSFaceIDUsageDescription</key>
	<string>WILCO uses Face ID to sign you back in instantly instead of retyping your PIN.</string>
	<!-- Camera + photo library: the form-review upload and the "photo of your
	     program" inputs are plain HTML file inputs (src/App.jsx videoInputRef,
	     athletePhotoRef; src/coach.jsx programPhotoRef). isNativeIOS() gates
	     payments, push, biometrics and OTA, and deliberately does NOT gate these,
	     so the WKWebView presents the iOS picker. Its "Take Photo or Video" option
	     TERMINATES the process without NSCameraUsageDescription. These two keys are
	     what keep form review from killing the app on a reviewer's device. -->
	<key>NSCameraUsageDescription</key>
	<string>WILCO uses the camera so you can film a lift and send it for form review.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>WILCO needs access to your photos so you can send an existing lift video or a photo of your program.</string>
	<!-- WILCO only uses the HTTPS/TLS built into iOS and ships no crypto of its own, so it
	     is exempt. Declaring it here stops App Store Connect holding every new build at
	     "Missing Compliance", which makes the build invisible to TestFlight testers and
	     sends no invite email. Build 4 was answered by hand for exactly this reason. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- development here is correct: App Store / TestFlight distribution flips it
	     to production automatically at export. Without this file APNs registration
	     fails silently and native push never works. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
